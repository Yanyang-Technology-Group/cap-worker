{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cap-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cap.yanyn.cn",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "CAP_DB",
      "database_name": "cap-data",
      "database_id": "你的D1数据库ID"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
