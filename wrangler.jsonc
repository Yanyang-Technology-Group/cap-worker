{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cap-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "cap.yanyn.cn/*",
      "custom_domain": true
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["CapStorageDurableObject"],
      "tag": "v1"
    }
  ],
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "CapStorageDurableObject",
        "name": "CAP_STORAGE"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
